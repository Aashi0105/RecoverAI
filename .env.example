# Razorpay Test Mode API Credentials & Webhook Secret
# Obtain these from your Razorpay Dashboard (Settings -> API Keys & Webhooks) in Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# LLM Provider API Key (e.g. OpenAI / Anthropic / Gemini / Groq)
LLM_API_KEY=your_llm_api_key_here

# Database Connection URL
# For local development SQLite: sqlite:///./recover_ai.db
# For PostgreSQL: postgresql://user:password@localhost:5432/recover_ai_db
DATABASE_URL=sqlite:///./recover_ai.db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
