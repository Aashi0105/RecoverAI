# Razorpay Test Mode API Credentials & Webhook Secret
# Obtain these from your Razorpay Dashboard (Settings -> API Keys & Webhooks) in Test Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider Configuration (Optional - Defaults to zero-downtime deterministic heuristic fallback)
# Set LLM_ENABLED=true and provide a valid LLM_API_KEY to activate real LLM diagnosis & recommendation
#
# Option A: Groq (Recommended for ultra-fast inference)
# LLM_ENABLED=true
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your_groq_api_key_here
#
# Option B: OpenAI
# LLM_ENABLED=true
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your_openai_api_key_here
#
# Default (Heuristic Fallback Mode - No API Key required):
LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here

# Database Connection URL
# For local development SQLite: sqlite:///./recover_ai.db
# For PostgreSQL: postgresql://<user>:<password>@localhost:5432/recover_ai_db
DATABASE_URL=sqlite:///./recover_ai.db

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed frontend origins (e.g. Netlify deployment URL & local dev ports)
# For production: CORS_ORIGINS=https://your-site.netlify.app,http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
